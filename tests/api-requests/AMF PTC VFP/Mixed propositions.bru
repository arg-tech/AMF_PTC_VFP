meta {
  name: Mixed propositions
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/
  body: multipartForm
  auth: inherit
}

headers {
  Content-Type: multipart/form-data
}

body:multipart-form {
  file: @file(test-inputs/xaif_mixed_propositions.json)
}

tests {
  const validPropTypes = ["Value", "Fact", "Policy", "None"];
  const inputINodeIDs = [1, 2, 3];

  test("Response status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("Response contains propositionClassifier key", function () {
    const body = res.getBody();
    expect(body).to.have.property("propositionClassifier");
    expect(body.propositionClassifier).to.have.property("nodes");
    expect(body.propositionClassifier.nodes).to.be.an("array");
  });

  test("All I-nodes are classified", function () {
    const body = res.getBody();
    const classifiedIDs = body.propositionClassifier.nodes.map(n => n.nodeID);
    for (const id of inputINodeIDs) {
      expect(classifiedIDs).to.include(id);
    }
  });

  test("All classifications have valid propType labels", function () {
    const body = res.getBody();
    for (const node of body.propositionClassifier.nodes) {
      expect(node).to.have.property("nodeID");
      expect(node).to.have.property("propType");
      expect(validPropTypes).to.include(node.propType);
    }
  });

  test("Original AIF structure is preserved", function () {
    const body = res.getBody();
    expect(body).to.have.property("AIF");
    expect(body.AIF).to.have.property("nodes");
    expect(body.AIF).to.have.property("edges");
    expect(body.AIF.nodes).to.have.length(4);
    expect(body.AIF.edges).to.have.length(2);
  });
}
